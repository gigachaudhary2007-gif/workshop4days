{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile record created on signup",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Unique user ID matching Firebase Auth UID" },
        "name": { "type": "string", "description": "User display or legal name" },
        "email": { "type": "string", "description": "User email address" },
        "createdAt": { "type": "string", "description": "ISO 8601 account creation timestamp" },
        "avatar": { "type": "string", "description": "Optional avatar URL" },
        "gradeLevel": { "type": "string", "description": "Academic grade level or program" },
        "studyGoalHours": { "type": "number", "description": "Daily study target in hours" },
        "streakDays": { "type": "number", "description": "Study streak in days" }
      },
      "required": ["userId", "name", "email", "createdAt"]
    },
    "Note": {
      "title": "Note",
      "description": "User note record containing synthesized text, summary, and optional uploaded file link",
      "type": "object",
      "properties": {
        "noteId": { "type": "string", "description": "Unique note identifier" },
        "userId": { "type": "string", "description": "Owner user ID" },
        "title": { "type": "string", "description": "Note title" },
        "content": { "type": "string", "description": "Note content or structured body" },
        "originalFileUrl": { "type": "string", "description": "Optional storage URL for original handwritten note or document" },
        "createdAt": { "type": "string", "description": "ISO 8601 timestamp of creation" },
        "updatedAt": { "type": "string", "description": "ISO 8601 timestamp of last modification" }
      },
      "required": ["noteId", "userId", "title", "content", "createdAt", "updatedAt"]
    },
    "Doubt": {
      "title": "Doubt",
      "description": "User doubt inquiry record with question, optional uploaded question image, and solution",
      "type": "object",
      "properties": {
        "doubtId": { "type": "string", "description": "Unique doubt identifier" },
        "userId": { "type": "string", "description": "Owner user ID" },
        "question": { "type": "string", "description": "Question text asked by student" },
        "imageUrl": { "type": "string", "description": "Optional storage URL for uploaded question diagram or handwritten image" },
        "answer": { "type": "string", "description": "Answer or solution explanation" },
        "createdAt": { "type": "string", "description": "ISO 8601 timestamp of inquiry" }
      },
      "required": ["doubtId", "userId", "question", "createdAt"]
    },
    "StudyActivity": {
      "title": "StudyActivity",
      "description": "User study log and session activity record",
      "type": "object",
      "properties": {
        "activityId": { "type": "string", "description": "Unique activity log identifier" },
        "userId": { "type": "string", "description": "Owner user ID" },
        "date": { "type": "string", "description": "ISO date string for activity" },
        "activityType": { "type": "string", "description": "Type of study activity (e.g., read_note, solve_doubt, quiz)" }
      },
      "required": ["activityId", "userId", "date", "activityType"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile document keyed by auth UID"
    },
    "users/{userId}/notes/{noteId}": {
      "schema": "Note",
      "description": "User personal notes strictly isolated by user ID"
    },
    "users/{userId}/doubts/{doubtId}": {
      "schema": "Doubt",
      "description": "User doubt records and solutions strictly isolated by user ID"
    },
    "users/{userId}/study_activities/{activityId}": {
      "schema": "StudyActivity",
      "description": "User study activity logs strictly isolated by user ID"
    }
  }
}
